{
  "name": "power-grid-operations",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "author": "chira-florian-mircea",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "yarn workspace @pgo/web dev",
    "build": "yarn workspace @pgo/web build",
    "start": "yarn workspace @pgo/web start",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test",
    "e2e": "yarn workspace @pgo/web e2e",
    "data:fetch": "yarn workspace @pgo/grid-model fetch:eia",
    "wasm:build": "yarn workspace @pgo/downsample build:wasm",
    "wasm:test": "yarn workspace @pgo/downsample test:rust",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "yarn workspace @pgo/ui storybook",
    "build:storybook": "yarn workspace @pgo/ui build:storybook"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  }
}
