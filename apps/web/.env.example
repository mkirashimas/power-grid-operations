# Copy to .env.local (git-ignored) and fill in. Production values live in Secret Manager.

# EIA open data API key (https://www.eia.gov/opendata/register.php). Server-side only.
EIA_API_KEY=

# WebSocket URL of the realtime service. Not a secret. Defaults to ws://localhost:8081, the
# port of `yarn dev:realtime`; on Cloud Run the deploy workflow sets it.
REALTIME_URL=
